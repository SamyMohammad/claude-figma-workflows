{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "available",
              "missing"
            ]
          },
          "license": {
            "enum": [
              "approved",
              "restricted",
              "unknown"
            ]
          }
        },
        "required": [
          "family",
          "weight",
          "path",
          "sha256",
          "status",
          "license"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "fonts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {}
}
