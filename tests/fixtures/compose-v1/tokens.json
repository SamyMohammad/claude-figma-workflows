{
  "base": {
    "space": {
      "small": {
        "$extensions": {
          "org.claude-figma-workflows.source": {
            "kind": "inferred",
            "nodeId": "synthetic:screen:home"
          }
        },
        "$type": "dimension",
        "$value": {
          "unit": "px",
          "value": 8
        }
      }
    }
  },
  "dark": {
    "badge": {
      "size": {
        "$type": "dimension",
        "$value": {
          "unit": "px",
          "value": 32
        }
      }
    },
    "card": {
      "height": {
        "$type": "dimension",
        "$value": {
          "unit": "px",
          "value": 64
        }
      }
    },
    "color": {
      "background": {
        "$type": "color",
        "$value": {
          "alpha": 1,
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ]
        }
      },
      "onPrimary": {
        "$type": "color",
        "$value": {
          "alpha": 1,
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ]
        }
      },
      "primary": {
        "$type": "color",
        "$value": {
          "alpha": 1,
          "colorSpace": "srgb",
          "components": [
            0.2,
            0.4,
            0.6
          ]
        }
      }
    },
    "control": {
      "height": {
        "$type": "dimension",
        "$value": {
          "unit": "px",
          "value": 48
        }
      }
    },
    "frame": {
      "size": {
        "$type": "dimension",
        "$value": {
          "unit": "px",
          "value": 160
        }
      }
    },
    "shape": {
      "radius": {
        "$type": "dimension",
        "$value": {
          "unit": "px",
          "value": 16
        }
      }
    },
    "space": {
      "small": {
        "$type": "dimension",
        "$value": "{base.space.small}"
      }
    },
    "type": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Roboto",
          "fontSize": {
            "unit": "px",
            "value": 16
          },
          "fontWeight": 400,
          "letterSpacing": {
            "unit": "px",
            "value": 0
          },
          "lineHeight": 1.5
        }
      }
    }
  },
