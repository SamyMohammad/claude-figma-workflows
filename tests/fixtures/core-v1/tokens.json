{
  "base": {
    "space": {
      "small": {
        "$extensions": {
          "org.claude-figma-workflows.source": {
            "kind": "inferred",
            "nodeId": "synthetic:screen:home"
          }
        },
        "$type": "dimension",
        "$value": {
          "unit": "px",
          "value": 8
        }
      }
    }
  },
  "dark": {
    "color": {
      "primary": {
        "$type": "color",
        "$value": {
          "alpha": 1,
          "colorSpace": "srgb",
          "components": [
            0.2,
            0.4,
            0.6
          ]
        }
      }
    },
    "space": {
      "small": {
        "$type": "dimension",
        "$value": "{base.space.small}"
      }
    },
    "type": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Synthetic Sans",
          "fontSize": {
            "unit": "px",
            "value": 14
          },
          "fontWeight": 400,
          "letterSpacing": {
            "unit": "px",
            "value": 0
          },
          "lineHeight": 1.4
        }
      }
    }
  },
  "light": {
    "color": {
      "primary": {
        "$type": "color",
        "$value": {
          "alpha": 1,
          "colorSpace": "srgb",
          "components": [
            0.2,
            0.4,
            0.6
          ]
        }
      }
    },
    "space": {
      "small": {
        "$type": "dimension",
        "$value": "{base.space.small}"
      }
    },
    "type": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Synthetic Sans",
          "fontSize": {
            "unit": "px",
            "value": 14
          },
          "fontWeight": 400,
          "letterSpacing": {
            "unit": "px",
            "value": 0
          },
          "lineHeight": 1.4
        }
      }
    }
  }
}
